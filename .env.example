# External backend settings
BACKEND_API_BASE_URL=https://api.example.com
BACKEND_API_TIMEOUT_MS=30000

# Server token cookie configuration
BACKEND_ACCESS_TOKEN_COOKIE_NAME=mr_impot_access_token
BACKEND_REFRESH_TOKEN_COOKIE_NAME=mr_impot_refresh_token
BACKEND_ACCESS_TOKEN_COOKIE_MAX_AGE_SECONDS=3600
BACKEND_REFRESH_TOKEN_COOKIE_MAX_AGE_SECONDS=2592000
BACKEND_COOKIE_SECURE=false

# Browser-facing integration settings
NEXT_PUBLIC_INTERNAL_API_BASE_PATH=/api

NODE_ENV=development
